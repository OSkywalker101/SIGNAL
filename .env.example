# ============ SIGNAL — Environment Configuration ============
# Copy to .env and fill values. NEVER commit .env or secrets.txt

# --- Ports (auto-fallback handled by start script) ---
SIGNAL_FRONTEND_PORT=3000
SIGNAL_API_PORT=8000
SIGNAL_N8N_PORT=5678
SIGNAL_PG_PORT=5432

# --- PostgreSQL ---
POSTGRES_USER=signal
POSTGRES_PASSWORD=change_me_in_prod
POSTGRES_DB=signal
DATABASE_URL=postgresql://signal:change_me_in_prod@localhost:5432/signal

# --- n8n ---
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678
N8N_ENCRYPTION_KEY=generate_a_random_32_char_key
N8N_ADMIN_EMAIL=admin@signal.local
N8N_ADMIN_PASSWORD=change_me_strong_password
N8N_API_KEY=

# --- LLM Providers (optional; system falls back to demo mode) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Notifications (all optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# --- Archives (optional) ---
NOTION_API_KEY=
NOTION_DATABASE_ID=
GOOGLE_CALENDAR_ID=primary

# --- Behavior ---
DEMO_MODE=true
SIGNAL_SCORING_WEIGHTS=novelty:0.15,acceleration:0.20,source_diversity:0.15,source_quality:0.15,cross_domain:0.20,independence:0.10,contradiction:0.05
LOG_LEVEL=INFO
